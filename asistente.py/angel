import tkinter as tk
import os
from PIL import Image, ImageTk

# ===========================================
# 📖 MODO SIN INTERNET
# ===========================================
conocimiento = {
    "hola": "¡Holaaa! 😊 Soy Ángel Dust. ¿Cómo estás? ✨",
    "quién eres": "Soy Ángel Dust, ¡tu asistente personal y amiga! 💖✨",
    "qué puedes hacer": "¡Puedo charlar contigo, contarte chistes y acompañarte! 💖✨",
    "cuéntame un chiste": "¿Qué le dice un semáforo a otro? ¡No me mires que me estoy cambiando! 😂✨",
    "cómo estás": "¡Muy feliz de estar contigo! 💖✨ ¿Y tú qué tal?",
    "adiós": "¡Hasta la próxima, amigo! 👋✨ ¡Vuelve pronto!",
    "te quiero": "¡Yo también a ti! Eres increíble 💖✨",
    "gracias": "¡No hay de qué! Estoy aquí para ti siempre 💜✨",
    "qué es hazbin hotel": "¡Es mi mundo favorito! 🏨✨ Un lugar donde todos podemos ser nosotros mismos 💖"
}

def obtener_respuesta_local(mensaje):
    texto = mensaje.lower().strip()
    for clave in conocimiento:
        if clave in texto:
            return conocimiento[clave]
    return "🤔 Eso suena interesante. ¡Cuéntame más sobre ello!"

# ===========================================
# 🌐 MODO CON INTERNET — Lista para cuando la necesites
# ===========================================
USAR_INTERNET = False
API_KEY = ""  # Pon tu clave aquí cuando la necesites

def consultar_ia_internet(mensaje):
    if not USAR_INTERNET or not API_KEY:
        return None
    try:
        import requests
        url = ""
        headers = {
            "Authorization": f"Bearer {API_KEY}",
            "Content-Type": "application/json"
        }
        datos = {
            "model": "",
            "messages": [
                {"role": "system", "content": "Eres Ángel Dust de Hazbin Hotel. Sé amable, divertido, usa emojis y responde breve. Habla en español natural."},
                {"role": "user", "content": mensaje}
            ],
            "max_tokens": 150,
            "temperature": 0.7
        }
        respuesta = requests.post(url, headers=headers, json=datos, timeout=30)
        if respuesta.status_code == 200:
            return respuesta.json()["choices"][0]["message"]["content"].strip()
    except Exception as e:
        print(f"Error: {e}")
    return None

# ===========================================
# 🔄 FUNCIÓN PRINCIPAL
# ===========================================
def obtener_respuesta(mensaje):
    if USAR_INTERNET and API_KEY:
        respuesta_internet = consultar_ia_internet(mensaje)
        if respuesta_internet:
            return respuesta_internet
    return obtener_respuesta_local(mensaje)

# ================= VENTANA =================
root = tk.Tk()
root.title("✨ Ángel Dust ✨")
root.geometry("400x650")
root.configure(bg="#1a1a2e")

estado = "💜 Modo local — Siempre lista"
color_estado = "#ffb3c1"
if USAR_INTERNET and API_KEY:
    estado = "🌐 En línea"
    color_estado = "#4ade80"

tk.Label(root, text="✨ Ángel Dust ✨", 
         font=("Consolas", 18, "bold"), fg="#ff69b4", bg="#1a1a2e").pack(pady=5)
tk.Label(root, text=estado, font=("Consolas", 9), 
         fg=color_estado, bg="#1a1a2e").pack(pady=5)

# ================= CAJA DE RESPUESTA =================
caja_respuesta = tk.Label(root, 
    text="¡Hola! Estoy aquí para ti 💜✨\nEscríbeme algo 👇",
    wraplength=350, font=("Consolas", 11), bg="#16213e", fg="#ffffff", padx=20, pady=20)
caja_respuesta.pack(pady=10, padx=20, fill="x")

# ================= TU FOTO CON ANIMACIÓN =================
frame_imagen = tk.Frame(root, bg="#1a1a2e", width=180, height=200)
frame_imagen.pack(pady=5)
frame_imagen.pack_propagate(False)

etiqueta_imagen = tk.Label(frame_imagen, bg="#1a1a2e")
etiqueta_imagen.place(relx=0.5, rely=0.5, anchor="center")

imagen_cargada = False
desplazamiento = 0
direccion = 1
max_desplazamiento = 4

ruta_imagen = "angel.png"
if os.path.exists(ruta_imagen):
    try:
        imagen = Image.open(ruta_imagen).resize((160, 180))
        foto = ImageTk.PhotoImage(imagen)
        etiqueta_imagen.config(image=foto)
        etiqueta_imagen.image = foto
        imagen_cargada = True
    except:
        pass

# 🎬 ANIMACIÓN
def animar():
    global desplazamiento, direccion
    if not imagen_cargada:
        return
    desplazamiento += direccion
    if desplazamiento >= max_desplazamiento:
        direccion = -1
    if desplazamiento <= -max_desplazamiento:
        direccion = 1
    etiqueta_imagen.place_configure(relx=0.5, rely=0.5 + (desplazamiento / 200), anchor="center")
    root.after(130, animar)

if imagen_cargada:
    root.after(100, animar)

# ================= ENTRADA Y BOTÓN =================
entrada = tk.Entry(root, font=("Consolas", 12), bg="#0f3460", fg="#ffffff")
entrada.pack(pady=10, padx=20, fill="x")
entrada.focus()

def enviar():
    texto = entrada.get().strip()
    if not texto:
        return
    caja_respuesta.config(text="💜 Pensando...")
    root.update()
    respuesta = obtener_respuesta(texto)
    caja_respuesta.config(text=respuesta)
    entrada.delete(0, tk.END)

tk.Button(root, text="✨ Enviar", command=enviar, bg="#ff69b4", fg="white", 
          font=("Consolas", 11, "bold"), relief="flat", padx=15, pady=8).pack(pady=15)
root.bind("<Return>", lambda e: enviar())

root.mainloop()