def cargar_memoria():
    if os.path.exists(ARCHIVO_MEMORIA):
        try:
            with open(ARCHIVO_MEMORIA, "r", encoding="utf-8") as f:
                datos = json.load(f)
                for clave in datos:
                    if clave not in conocimiento:
                        conocimiento[clave] = datos[clave]
        except:
            pass

def guardar_memoria():
    try:
        with open(ARCHIVO_MEMORIA, "w", encoding="utf-8") as f:
            json.dump(conocimiento, f, ensure_ascii=False, indent=2)
    except:
        pass

def aprender(mensaje):
    texto = mensaje.lower().strip()
    if "aprende:" in texto and "=" in texto:
        partes = texto.split("=", 1)
        clave = partes[0].replace("aprende:", "").strip()
        valor = partes[1].strip()
        if clave and valor:
            if clave in conocimiento:
                if isinstance(conocimiento[clave], list):
                    conocimiento[clave].append(valor)
                else:
                    conocimiento[clave] = [conocimiento[clave], valor]
            else:
                conocimiento[clave] = valor
            guardar_memoria()
            return "Lo he recordado. Si me preguntas '" + clave + "', responderé: '" + valor + "'"
    return None

def identificar_emocion(mensaje):
    texto = mensaje.lower()
    for palabra, emocion in palabras_emociones.items():
        if palabra in texto:
            return emocion
    return None

def pensar_y_respuesta(mensaje):
    texto = mensaje.lower().strip()
    
    nuevo = aprender(mensaje)
    if nuevo:
        return nuevo
    
    emocion = identificar_emocion(texto)
    if emocion and emocion in conocimiento:
        resp = conocimiento[emocion]
        return random.choice(resp) if isinstance(resp, list) else resp
    
    for clave in conocimiento:
        if clave in texto:
            resp = conocimiento[clave]
            return random.choice(resp) if isinstance(resp, list) else resp
    
    coincidencias = get_close_matches(texto, conocimiento.keys(), n=1, cutoff=0.55)
    if coincidencias:
        resp = conocimiento[coincidencias[0]]
        return random.choice(resp) if isinstance(resp, list) else resp
    
    respuestas_nuevas = [
        "No estoy segura de eso todavía. ¿Me lo puedes explicar?",
        "Es una buena pregunta. Aún estoy aprendiendo sobre ese tema.",
        "No conozco la respuesta todavía. ¿Quieres enseñármela?",
        "Interesante. ¿Podrías decirme más sobre eso?",
        "No estoy segura, pero me gustaría aprender. Escríbelo así: aprende: tu pregunta = tu respuesta"
    ]
    return random.choice(respuestas_nuevas)

def generar_pregunta():
    return random.choice(temas_interes)

